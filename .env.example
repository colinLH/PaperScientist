# Copy to .env, or set process environment variables. Never commit real secrets.
PS_MODEL=deepseek:deepseek-chat
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
OPENALEX_API_KEY=
PS_CONTEXT_TOKENS=64000
PS_OUTPUT_TOKENS=4096
PS_MAX_STEPS=24
PS_MAX_SUBAGENTS=3
PS_TOOL_TIMEOUT=90
PS_ALLOW_EXECUTION=false
PS_EXTRACT_MEMORY=true
# Optional: PS_DATA_DIR=E:/agent/.paperscientist
# Additional SKILL.md package roots, separated by ; on Windows or : on Linux:
# PS_SKILL_ROOTS=E:/my-research-skills
